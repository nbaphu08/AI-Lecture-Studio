# Copy this file to .env.local and fill in your own key. Never commit .env.local.
# Create a key for free in Google AI Studio: https://aistudio.google.com/apikey

# Required. Server-side only: do NOT rename it with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your_gemini_api_key

# Gemini model id. Pick a Flash model that your key can use on the free tier
# (see https://aistudio.google.com/ -> Rate limits). Defaults to gemini-3.8-flash.
# Verify with:  npm run dev  (in one terminal) and  npm run check:gemini  (in another).
GEMINI_MODEL=your_supported_flash_model

# Optional: enables /api/diagnostics on a deployed site (Authorization: Bearer <token>).
# Leave unset to keep it disabled in production. In `npm run dev` it is always available.
# DIAGNOSTICS_TOKEN=a_long_random_string

# Optional tuning (defaults shown)
# AI_MAX_OUTPUT_TOKENS=32768     # max tokens per answer (incl. thinking); must not exceed the model limit
# AI_MAX_DOC_CHARS=300000        # longest document text accepted
# AI_SINGLE_CALL_CHARS=45000     # up to this size the whole document goes in one request
# AI_CHUNK_CHARS=24000           # chunk size for longer documents
# AI_CONCURRENCY=1               # parallel Gemini requests (keep 1 on the free tier)
# AI_MAX_RETRIES=3               # retries for temporary errors
# AI_REQUEST_TIMEOUT_MS=90000
# AI_TOTAL_TIMEOUT_MS=270000
# RATE_LIMIT_MAX=8               # best-effort requests per IP per window (per server instance)
# RATE_LIMIT_WINDOW_MS=600000
# MAX_IN_FLIGHT=3
